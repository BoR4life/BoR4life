# Copy to .env.local for local development. Never commit .env.local.
#
# Analytics is entirely optional — if these are unset, PostHog never
# initialises and the site behaves identically. There is deliberately no
# default project key, so a fork or a fresh clone cannot silently start
# sending data somewhere unintended.

# Public site origin. Required in production for correct absolute OG image
# URLs — without it Next.js falls back to localhost, which is a common and
# silent misconfiguration.
NEXT_PUBLIC_SITE_URL=https://www.bundleofrays.com

# PostHog (optional). Use the EU host if data residency matters for
# institutional customers — for AU/UK/EU health buyers it usually does.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
