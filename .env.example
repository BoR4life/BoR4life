# Copy to .env.local for local development. Never commit .env.local.

# Public site origin. Required in production for correct absolute OG image
# URLs — without it Next.js falls back to localhost, a common and silent
# misconfiguration.
NEXT_PUBLIC_SITE_URL=https://www.bundleofrays.com

# ---------------------------------------------------------------------------
# Enquiry delivery (choose ONE)
# ---------------------------------------------------------------------------
# Option A — Resend (recommended). Requires verifying bundleofrays.com as a
# sending domain in Resend, which is a few DNS records. FROM must be on the
# verified domain; TO can be any inbox.
#
# Note on residency: Resend processes in the US. Fine for name/email/message,
# but if an institutional buyer requires in-region processing, swap for SES
# in ap-southeast-2 or Postmark EU — only deliver() in app/contact/actions.ts
# changes.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ENQUIRY_TO_EMAIL=brad@bundleofrays.com
# ENQUIRY_FROM_EMAIL=website@bundleofrays.com

# Option B — post the enquiry anywhere (Zapier, a CRM, an internal endpoint).
# ENQUIRY_WEBHOOK_URL=

# With neither set, enquiries are logged WITHOUT PII and not delivered.
# Safe for local development; must be configured before launch.

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# If unset, PostHog never initialises and the site behaves identically.
# There is deliberately no default key, so a fork cannot silently send data.
# Use the EU host if data residency matters to institutional customers.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
